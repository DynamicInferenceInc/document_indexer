# One indexer process = one profile. Copy this file to .env and fill in secrets.
# Nested keys use __ (SOURCE__WATCH_PATH, QDRANT__URL, MODELS__EMBEDDING_MODEL).

SOURCE__KIND=local
SOURCE__WATCH_PATH=/var/lib/document-indexer/docs
SOURCE__DEBOUNCE_SECONDS=1.0

# SOURCE__KIND=smb
# SOURCE__SERVER=fileserver
# SOURCE__SHARE=docs
# SOURCE__USERNAME=svc_indexer
# SOURCE__PASSWORD=change-me
# SOURCE__DOMAIN=CORP
# SOURCE__SUBPATH=1c-docs
# SOURCE__PORT=445
# SOURCE__TIMEOUT_SEC=30
# SOURCE__POLL_INTERVAL_SEC=15
# SOURCE__STAGING_PATH=/var/lib/document-indexer/staging
# SOURCE__MAX_BACKOFF_SEC=60

QDRANT__URL=http://127.0.0.1:6333
QDRANT__COLLECTION=docs

MODELS__OLLAMA_BASE_URL=http://127.0.0.1:11434
MODELS__EMBEDDING_MODEL=nomic-embed-text
MODELS__EMBEDDING_TIMEOUT_SEC=120
MODELS__CHUNK_SIZE=1024
MODELS__PICTURE_DESCRIPTION_ENABLED=true
MODELS__VLM_MODEL=qwen3-vl:8b
MODELS__VLM_TIMEOUT_SEC=90
MODELS__VLM_CONCURRENCY=2
MODELS__PICTURE_AREA_THRESHOLD=0.02

INDEX_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.csv,.pdf,.docx,.pptx,.xlsx,.xls,.html,.htm
# Omit INDEX_EXTENSIONS to index every Docling-readable type. Unknown suffixes fail at startup.
LOG_LEVEL=INFO
