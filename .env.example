# One indexer process = one profile. Copy this file to .env and fill in secrets.

SOURCE_TYPE=local
WATCH_PATH=/var/lib/document-indexer/docs
DEBOUNCE_SECONDS=1.0

# SOURCE_TYPE=smb
# SMB_SERVER=fileserver
# SMB_SHARE=docs
# SMB_USERNAME=svc_indexer
# SMB_PASSWORD=change-me
# SMB_DOMAIN=CORP
# SMB_SUBPATH=1c-docs
# SMB_PORT=445
# SMB_TIMEOUT_SEC=30
# SMB_POLL_INTERVAL_SEC=15
# SMB_STAGING_PATH=/var/lib/document-indexer/staging
# SMB_MAX_BACKOFF_SEC=60

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=docs

OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SEC=120
CHUNK_SIZE=1024
PICTURE_DESCRIPTION_ENABLED=true
VLM_MODEL=qwen3-vl:8b
VLM_TIMEOUT_SEC=90
VLM_CONCURRENCY=2
PICTURE_AREA_THRESHOLD=0.02

INDEX_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.csv,.pdf,.docx,.pptx,.xlsx,.xls,.html,.htm
# Omit INDEX_EXTENSIONS to index every Docling-readable type. Unknown suffixes fail at startup.
LOG_LEVEL=INFO
